# Browser-exposed key: restrict this in Google Cloud Console to
# HTTP referrers (your domain) and to the Maps JavaScript API + Places API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only key: restrict this to your server's IP and to the
# Distance Matrix API, Routes API, and Geocoding API only.
# Never expose this one to the client.
GOOGLE_MAPS_SERVER_API_KEY=

# Server-only. Free key from https://tollguru.com/developers (Get API Key).
# Powers toll-plaza locations + per-vehicle (FASTag/cash) pricing along the route.
# Optional: without it the app just shows no toll plazas.
TOLLGURU_API_KEY=
